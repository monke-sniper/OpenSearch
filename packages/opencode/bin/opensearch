#!/usr/bin/env node

/**
 * OpenSearch Launcher - Interactive CLI with thinking streaming
 * Wrapper that adds --agent search and --thinking by default
 */

const { spawn } = require('child_process');
const path = require('path');

function main() {
  try {
    // Direct path to the main TypeScript entry point
    const scriptPath = path.join(__dirname, '..', 'src', 'index.ts');
    
    // Verify the script exists
    const fs = require('fs');
    if (!fs.existsSync(scriptPath)) {
      throw new Error(`Could not find opencode script at ${scriptPath}`);
    }
    
    // Parse arguments to avoid duplicating --agent and --thinking
    const args = process.argv.slice(2);
    let hasAgent = false;
    let hasThinking = false;
    
    for (let i = 0; i < args.length; i++) {
      const arg = args[i];
      if (arg === '--agent' || arg === '-a') {
        hasAgent = true;
        // Skip the next argument which is the agent name
        i++;
        continue;
      }
      if (arg.startsWith('--agent=') || arg.startsWith('-a=')) {
        hasAgent = true;
        continue;
      }
      if (arg === '--thinking') {
        hasThinking = true;
        continue;
      }
    }
    
    // Build final arguments
    const finalArgs = [...args];
    if (!hasAgent) {
      finalArgs.unshift('search');
      finalArgs.unshift('--agent');
    }
    if (!hasThinking) {
      finalArgs.push('--thinking');
    }
    
    // Spawn bun run with the TypeScript source using full path to bun
    const bunPath = 'C:\\Users\\idkch\\.bun\\bin\\bun.exe';
    const proc = spawn(bunPath, ['run', scriptPath, ...finalArgs], {
      stdio: 'inherit',
      windowsVerbatimArguments: true,
      env: { ...process.env, AGENT: "1", OPENCODE: "1" }
    });
    
    proc.on('error', (err) => {
      console.error('Failed to start opencode:', err);
      process.exit(1);
    });
    
    proc.on('close', (code) => {
      process.exit(code);
    });
  } catch (err) {
    console.error('Error:', err.message);
    process.exit(1);
  }
}

main();